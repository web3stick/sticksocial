{
	"extends": "./.svelte-kit/tsconfig.json",
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"bin/**/*.ts",
		"bin/**/*.js"
	],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}
